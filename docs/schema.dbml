// 페어카 크루 서버 데이터 모델 (기획서 별지 기술명세 T4 우회 거리, T5 정산 알고리즘 기준)
//
// FK로 막을 수 없어 서버 로직에서 검증하는 규칙
// 1. trips.driver_id의 멤버가 trips.car_id를 member_cars에 등록해 둬야 함
//    (아래에서 "운행의 크루"는 trips.driver_id의 crew_members.crew_id)
// 2. trips의 origin_place_id, destination_place_id는 운행의 크루 장소여야 함
// 3. boardings.crew_member_id는 운행의 크루 소속이고, 운전자가 아니어야 함
// 4. boardings의 board_place_id, alight_place_id는 운행의 크루 장소여야 함
// 5. 운행 시작 전 운전자의 member_bank_accounts가 있어야 함 (영수증 계좌 스냅샷이 not null)
// 6. crew_member_detours의 동승자, 운전자, 장소는 같은 크루이고, 동승자와 운전자는 달라야 함
// 7. 크루에서 동승자가 쓰는 승차 지점은 최대 2곳 (기술명세 T8: 경유지 최대 2개)
// 8. trip_segments는 한 운행 안에서 seq 순서대로 이어져야 함 (앞 구간 end_odometer_km = 다음 구간 start_odometer_km)
//    trip_segment_riders의 구간과 탑승은 같은 운행이어야 함
// 9. receipts의 payer와 payee는 같은 크루이고 서로 달라야 함
// 10. receipt_items의 탑승은 receipts.payer_id의 탑승이고, 그 운행의 운전자가 receipts.payee_id여야 함
// 11. crews의 기본 출발지·목적지, crew_members의 평소 탈 곳·내릴 곳, crew_attendances의 탈 곳은 그 크루 장소여야 함

// ---------- Enum ----------

// 연료 종류. 평균 유가를 고르고 연비, 유가 단위를 정할 때 사용
Enum fuel_type {
  GASOLINE  // 휘발유
  DIESEL    // 경유
  LPG       // LPG
  HYBRID    // 하이브리드 (휘발유 기준으로 계산)
  EV        // 전기 (연비 km/kWh, 유가 원/kWh)
}

// 크루 정산 방식 (기술명세 T5)
Enum settlement_mode {
  FAIR           // 공정 분할 (기본): 구간 비용을 구간 탑승 인원으로 나누고 우회 거리 비용을 더함
  EQUAL          // 균등 분할: 운행 비용을 탑승 인원으로 똑같이 나눔
  FIXED_MONTHLY  // 월 정액: 크루가 정한 금액을 매달 청구
}

// 연비 출처. 영수증 표시 문구가 바뀜
Enum fuel_economy_source {
  MEASURED  // 차량 실측
  MANUAL    // 입력 연비 (실측 미지원 차종. 영수증에 "입력 연비"로 표시)
}

// ---------- 엔티티 ----------

// 사용자 (운전자, 동승자 공통. 역할은 운행마다 정해짐)
Table members {
  id bigint [pk, increment]          // 멤버 식별자
  nickname varchar(30) [not null]    // 크루 안에서 보이는 이름 (TTS "수아님 탑승했어요"에 사용)
  created_at timestamptz [not null]  // 가입 시각
}

// 멤버의 정산 받을 계좌 (운전자만 등록. 멤버당 최대 1개)
Table member_bank_accounts {
  id bigint [pk, increment]                               // 계좌 식별자
  member_id bigint [not null, unique, ref: - members.id]  // 계좌 주인 (1:1)
  bank_name varchar(30) [not null]                        // 은행명
  account_number varchar(30) [not null]                   // 계좌번호
  account_holder varchar(30) [not null]                   // 예금주
  created_at timestamptz [not null]                       // 등록 시각
  updated_at timestamptz [not null]                       // 수정 시각
}

// 멤버의 인증 토큰 (기기, 브라우저마다 1개. 개별 폐기 가능)
Table member_tokens {
  id bigint [pk, increment]                       // 토큰 식별자
  member_id bigint [not null, ref: > members.id]  // 토큰 주인
  token_hash varchar(64) [not null, unique]       // 토큰 해시 (원문은 저장하지 않음)
  expires_at timestamptz [not null]               // 만료 시각
  revoked_at timestamptz                          // 폐기 시각. 채워지면 사용 불가
  created_at timestamptz [not null]               // 발급 시각

  indexes {
    member_id  // 멤버의 토큰 일괄 폐기
  }
}

// 차량 (Pleos Connect 탑재 차량)
Table cars {
  id bigint [pk, increment]                   // 차량 식별자
  vehicle_key varchar(64) [not null, unique]  // Pleos Connect 차량 식별값
  fuel_type fuel_type [not null]              // 연료 종류
  manual_fuel_economy decimal(5,2)            // 입력 연비 (km/L, EV는 km/kWh). 실측 연비를 못 쓰는 차종만 입력
  manual_fuel_price_won int                   // 직접 입력 유가 (원/L, EV는 원/kWh). 집 충전 단가처럼 공공 평균과 다를 때만. 비어 있으면 fuel_prices 사용. 차를 등록한 멤버만 수정
  created_at timestamptz [not null]           // 등록 시각
}

// 카풀 크루
Table crews {
  id bigint [pk, increment]                                   // 크루 식별자
  name varchar(50) [not null]                                 // 크루 이름 (예: 판교 출근 크루)
  settlement_mode settlement_mode [not null, default: 'FAIR'] // 정산 방식
  include_driver boolean [not null, default: true]            // 구간 탑승 인원에 운전자를 포함할지
  monthly_fixed_won int                                       // 월 정액 금액 (settlement_mode가 FIXED_MONTHLY일 때만)
  departure_time time                                         // 평소 출발 시각 (KST). 아래 일정은 기본값이고 운행은 그날 정한 대로 시작
  arrival_time time                                           // 평소 도착 시각 (KST)
  settlement_changed_at timestamptz                           // 정산 방식(나누는 방법, 운전자 포함)이 마지막으로 바뀐 시각. 이보다 먼저 한 동의는 다시 받음
  departure_days int [not null, default: 0]                   // 카풀하는 요일 비트 (월=1, 화=2, 수=4, ... 일=64)
  origin_place_id bigint [ref: > crew_places.id]              // 기본 출발지
  destination_place_id bigint [ref: > crew_places.id]         // 기본 목적지
  created_at timestamptz [not null]                           // 생성 시각
}

// 월평균 유가 (공공 유가 정보 API에서 수집)
Table fuel_prices {
  id bigint [pk, increment]          // 유가 식별자
  fuel_type fuel_type [not null]     // 연료 종류
  month date [not null]               // 기준 월 (매월 1일. 예: 2026-11-01)
  price_won int [not null]            // 월평균 가격 (원/L, EV는 원/kWh)
  collected_at timestamptz [not null] // 수집 시각

  indexes {
    (fuel_type, month) [unique]  // 연료, 월마다 1개
  }
}

// ---------- 관계 ----------

// 멤버가 차를 소유하거나 운전함
Table member_cars {
  id bigint [pk, increment]                       // 멤버-차량 식별자
  member_id bigint [not null, ref: > members.id]  // 멤버
  car_id bigint [not null, ref: > cars.id]        // 차량
  created_at timestamptz [not null]               // 등록 시각

  indexes {
    (member_id, car_id) [unique]  // 같은 멤버-차량 중복 등록 방지
  }
}

// 멤버가 크루에 참여함
Table crew_members {
  id bigint [pk, increment]                       // 크루 멤버 식별자
  crew_id bigint [not null, ref: > crews.id]      // 크루
  member_id bigint [not null, ref: > members.id]  // 멤버
  joined_at timestamptz [not null]                // 참여 시각
  board_place_id bigint [ref: > crew_places.id]   // 동승자로 탈 때 평소 탈 곳
  alight_place_id bigint [ref: > crew_places.id]  // 동승자로 탈 때 평소 내릴 곳
  pickup_time time                                // 평소 픽업 시각 (KST)
  settlement_agreed_at timestamptz                // 정산 기준에 동의한 시각

  indexes {
    (crew_id, member_id) [unique]  // 같은 크루에 중복 참여 방지
  }
}

// 크루 초대 코드
Table crew_invites {
  id bigint [pk, increment]                   // 초대 식별자
  crew_id bigint [not null, ref: > crews.id]  // 초대할 크루
  code varchar(32) [not null, unique]         // 초대 링크에 들어가는 코드
  expires_at timestamptz [not null]           // 만료 시각. 지나면 참여 불가
  created_at timestamptz [not null]           // 발급 시각

  indexes {
    crew_id  // 크루의 초대 코드 조회
  }
}

// 크루의 장소 (○○아파트 정문, 회사, 운전자 집). 크루 멤버 누구나 등록하고 크루 전체가 같이 씀
// 운행의 출발지, 목적지, 탑승, 하차 지점이 모두 여기를 가리킴
Table crew_places {
  id bigint [pk, increment]                   // 장소 식별자
  crew_id bigint [not null, ref: > crews.id]  // 장소를 쓰는 크루
  name varchar(50) [not null]                 // 장소 이름
  latitude decimal(9,6) [not null]            // 위도 (경유지, 목적지 설정에 사용)
  longitude decimal(9,6) [not null]           // 경도
  created_at timestamptz [not null]           // 등록 시각

  indexes {
    (crew_id, name) [unique]  // 같은 크루에 같은 이름 장소 중복 방지. 크루 장소 목록 조회
  }
}

// 그날 출석. 기본은 "탐"이라 안 타는 날이나 그날만 다른 곳에서 타는 날만 행이 생김
// 차량 앱이 출발 전에 오늘 태울 사람과 경유지를 정하는 데 씀
Table crew_attendances {
  id bigint [pk, increment]                               // 출석 식별자
  crew_member_id bigint [not null, ref: > crew_members.id] // 크루 멤버
  service_date date [not null]                            // 운행일 (KST)
  attending boolean [not null]                            // 그날 타는지
  board_place_id bigint [ref: > crew_places.id]           // 그날만 다른 탈 곳 (비어 있으면 평소 탈 곳)
  delay_minutes int                                       // 출발 전에 알린 그날 지각 (분, 1~120). 안 타는 날이면 비움
  updated_at timestamptz [not null]                       // 마지막 변경 시각

  indexes {
    (crew_member_id, service_date) [unique]  // 하루에 한 행
  }
}

// 운전자가 동승자를 이 장소에서 태우거나 내려 주느라 더 달리는 거리 (기술명세 T4)
// 크루 합류 때 1번 산출하고 양측이 확인한 값을 정산 기준으로 씀. 매일 다시 계산하지 않음
// 출근은 승차 지점, 퇴근은 하차 지점을 place_id로 따로 등록
// 동승자가 둘이면: 전체 경유 경로 - 그 사람 경유지만 뺀 경로. 개인 합계가 전체 우회 거리와 다르면 비율로 맞춤
Table crew_member_detours {
  id bigint [pk, increment]                               // 우회 거리 식별자
  passenger_id bigint [not null, ref: > crew_members.id]  // 동승자
  driver_id bigint [not null, ref: > crew_members.id]     // 운전자 (교대 운전이면 운전자마다 따로)
  place_id bigint [not null, ref: > crew_places.id]       // 경유하는 장소 (승차 지점 또는 하차 지점)
  detour_km decimal(6,1) [not null]                       // 우회 거리 (경유 거리 - 직행 거리)
  driver_confirmed_at timestamptz                         // 운전자 확인 시각
  passenger_confirmed_at timestamptz                      // 동승자 확인 시각. 둘 다 채워져야 정산에 사용
  created_at timestamptz [not null]                       // 산출 시각
  updated_at timestamptz [not null]                       // 갱신 시각 (Odometer 실측 보정에 크루가 동의했을 때)

  indexes {
    (passenger_id, driver_id, place_id) [unique]  // 같은 동승자, 운전자, 장소에 우회 거리 1개
  }
}

// 크루 멤버가 멤버의 차로 출발지에서 목적지까지 운행함 (출발, 도착 측정값 포함)
Table trips {
  id bigint [pk, increment]                                      // 운행 식별자
  driver_id bigint [not null, ref: > crew_members.id]            // 운전한 크루 멤버 (크루는 crew_members.crew_id로 찾음)
  car_id bigint [not null, ref: > cars.id]                       // 운행한 차량
  origin_place_id bigint [not null, ref: > crew_places.id]       // 출발지
  destination_place_id bigint [not null, ref: > crew_places.id]  // 목적지 (내비 목적지)
  service_date date [not null]                                   // 운행일 (KST 기준. 월 정산 집계 기준)
  started_at timestamptz [not null]                              // 출발 시각 (시동)
  ended_at timestamptz                                           // 도착 시각. 비어 있으면 운행 중
  start_odometer_km decimal(9,1) [not null]                      // 출발 시점 누적 주행거리
  end_odometer_km decimal(9,1)                                   // 도착 시점 누적 주행거리
  toll_fare_won int [not null, default: 0]                       // 그날 통행료 (RouteStartInfo.tollFare)
  route_polyline text                                            // 운행 전체 실제 주행 경로 (Encoded Polyline). NaviHelper는 경로 좌표를 주지 않으므로 차량 앱이 FusedLocation으로 모아 도착 후 업로드

  indexes {
    (driver_id, service_date)  // 운전자 기준 월 정산 조회
  }
}

// 크루 멤버가 운행에 탑승함 (탑승, 하차 지점과 측정값 포함)
// 운행 시작 때 탈 사람마다 1행 생성. 경유지는 이 행들의 지점으로 정함
// boarded_at이 끝까지 비어 있으면 미탑승 (정산 제외). "오늘은 안 타요"는 운행 전 행 삭제
Table boardings {
  id bigint [pk, increment]                                 // 탑승 식별자
  trip_id bigint [not null, ref: > trips.id]                // 탑승한 운행
  crew_member_id bigint [not null, ref: > crew_members.id]  // 탑승한 크루 멤버 (운전자 제외)
  board_place_id bigint [not null, ref: > crew_places.id]   // 탈 예정 지점 (경유지 설정에 사용)
  alight_place_id bigint [not null, ref: > crew_places.id]  // 내릴 예정 지점 (실제 하차 위치와 다를 수 있음)
  boarded_at timestamptz                                    // 탑승 시각. 탑승 감지 시 채움
  board_odometer_km decimal(9,1)                            // 탑승 시점 누적 주행거리 (구간 경계)
  alighted_at timestamptz                                   // 하차 시각
  alight_odometer_km decimal(9,1)                           // 하차 시점 누적 주행거리 (구간 경계). 감지 실패 시 trips.end_odometer_km로 채움

  indexes {
    (trip_id, crew_member_id) [unique]  // 운행 1회에 같은 멤버 1번만 탑승
    crew_member_id                      // 멤버별 탑승 조회
  }
}

// 운행을 탑승 인원이 바뀌는 지점마다 나눈 구간 (기술명세 T5)
// 출발부터 도착까지 모든 구간을 저장 (운전자 혼자 달린 구간 포함). 구간 경로는 trips.route_polyline을 점 번호 범위로 잘라 구함
// 운전자 혼자 달린 구간(trip_segment_riders 행 없음)은 정산하지 않음
Table trip_segments {
  id bigint [pk, increment]                              // 구간 식별자
  trip_id bigint [not null, ref: > trips.id]             // 운행
  seq smallint [not null]                                // 운행 안에서 구간 순서 (1부터)
  start_odometer_km decimal(9,1) [not null]              // 구간 시작 누적 주행거리
  end_odometer_km decimal(9,1) [not null]                // 구간 끝 누적 주행거리
  fuel_economy decimal(5,2) [not null]                   // 구간 평균 연비 (km/L, EV는 km/kWh)
  fuel_economy_source fuel_economy_source [not null]     // 연비 출처 (실측 / 입력)
  start_point_index int                                  // trips.route_polyline에서 이 구간이 시작하는 점 번호 (구간 경로 = 전체 경로를 이 범위로 자른 것)
  end_point_index int                                    // trips.route_polyline에서 이 구간이 끝나는 점 번호

  indexes {
    (trip_id, seq) [unique]  // 운행 안에서 구간 순서 중복 방지
  }
}

// 구간에 탄 동승자 (구간과 탑승의 다대다 관계). 운전자는 넣지 않음
// 구간 탑승 인원 = 이 테이블의 행 수 (+ crews.include_driver면 운전자 1명)
Table trip_segment_riders {
  id bigint [pk, increment]                                // 구간 탑승 식별자
  trip_segment_id bigint [not null, ref: > trip_segments.id] // 구간
  boarding_id bigint [not null, ref: > boardings.id]       // 이 구간에 타고 있던 탑승

  indexes {
    (trip_segment_id, boarding_id) [unique]  // 같은 구간에 같은 탑승 중복 방지
    boarding_id                              // 탑승별로 탄 구간 조회 (정산)
  }
}

// 동승자가 운전자에게 낼 월 영수증 (월말 1번 발행. 발행 후 고정)
// 탑승 일수, 거리, 유류비, 통행료 합계는 receipt_items를 합산해 구함 (저장하지 않음)
// 교대 운전 상계(PT 단계)는 같은 크루의 반대 방향 영수증과 차액을 계산해 처리
Table receipts {
  id bigint [pk, increment]                                       // 영수증 식별자
  payer_id bigint [not null, ref: > crew_members.id]              // 내는 사람 (동승자)
  payee_id bigint [not null, ref: > crew_members.id]              // 받는 사람 (운전자)
  month date [not null]                                           // 정산 월 (매월 1일. 예: 2026-11-01)
  settlement_mode settlement_mode [not null]                      // 발행 시점 크루 정산 방식 스냅샷
  fuel_economy decimal(5,2) [not null]                            // 평균 연비 (거리 가중 평균. 영수증 표시값)
  fuel_economy_source fuel_economy_source [not null]              // 연비 출처. 입력 연비가 하나라도 섞이면 MANUAL
  fuel_price_won int [not null]                                   // 적용 유가 (원/L, EV는 원/kWh)
  amount_won int [not null]                                       // 보낼 금액 (receipt_items 합계를 100원 단위 올림. 월 정액이면 정액)
  payee_bank_name varchar(30) [not null]                          // 발행 시점 은행명 스냅샷
  payee_account_number varchar(30) [not null]                     // 발행 시점 계좌번호 스냅샷
  payee_account_holder varchar(30) [not null]                     // 발행 시점 예금주 스냅샷
  waived_at timestamptz                                           // 면제 시각 ("이번 달은 내가 낼게"). 채워지면 0원 영수증
  issued_at timestamptz [not null]                                // 발행 시각

  indexes {
    (payer_id, payee_id, month) [unique]  // 같은 동승자, 운전자, 월에 영수증 1장. 동승자 영수증 조회
    (payee_id, month)                     // 운전자 영수증 조회
  }
}

// 월 영수증의 하루치 줄 (탑승 1건 = 1줄)
// 월말 이후 늦게 올라온 탑승은 다음 달 영수증에 들어감 (발행된 영수증은 바뀌지 않음)
Table receipt_items {
  id bigint [pk, increment]                                   // 영수증 줄 식별자
  receipt_id bigint [not null, ref: > receipts.id]            // 월 영수증
  boarding_id bigint [not null, unique, ref: - boardings.id]  // 정산한 탑승 (탑승 1건은 영수증 1장에만). 이 행이 없는 탑승은 미정산
  shared_distance_km decimal(8,1) [not null]                  // 이날 함께 탄 거리
  shared_cost_won decimal(10,2) [not null]                    // 이날 구간 분담금 합계 (Σ 구간 거리 × km당 비용 ÷ 구간 인원)
  detour_km decimal(6,1) [not null]                           // 이날 적용한 우회 거리 (crew_member_detours 스냅샷)
  detour_cost_won decimal(10,2) [not null]                    // 우회 거리 × km당 비용
  toll_won decimal(10,2) [not null]                           // 이날 통행료 분담. 이날 부담금 = shared_cost_won + detour_cost_won + toll_won

  indexes {
    receipt_id  // 영수증 내역 조회
  }
}

// ---------- 실시간 알림 (live 모듈) ----------

// 영수증 기록 확인 요청 ("이 기록에 문제가 있나요?"). 영수증은 바꾸지 않고 운전자가 보고 처리했다고 표시
Table receipt_inquiries {
  id bigint [pk, increment]                                 // 요청 식별자
  receipt_id bigint [not null, ref: > receipts.id]          // 영수증
  requester_id bigint [not null, ref: > crew_members.id]    // 요청한 사람 (영수증의 내는 사람)
  message varchar(500) [not null]                           // 무엇이 이상한지
  created_at timestamptz [not null]                         // 요청 시각
  resolved_at timestamptz                                   // 운전자가 처리했다고 표시한 시각

  indexes {
    receipt_id  // 영수증의 요청 목록
  }
}

// 브라우저 Web Push 구독 (기기, 브라우저마다 1행)
// 알림 채널 데이터라 엔티티 연관관계 없이 member_id 값만 가짐 (live 모듈이 member 모듈에 묶이지 않도록)
Table push_subscriptions {
  id bigint [pk, increment]                   // 구독 식별자
  member_id bigint [not null, ref: > members.id] // 구독한 멤버
  endpoint varchar(1024) [not null, unique]   // 브라우저 푸시 서비스 주소
  p256dh varchar(255) [not null]              // 메시지 암호화용 브라우저 공개키 (base64url)
  auth varchar(255) [not null]                // 메시지 암호화용 인증 비밀값 (base64url)
  created_at timestamptz [not null]           // 등록 시각
  updated_at timestamptz [not null]           // 갱신 시각 (다른 멤버로 바뀌거나 키가 바뀜)

  indexes {
    member_id  // 멤버의 구독 조회 (알림 발송)
  }
}
