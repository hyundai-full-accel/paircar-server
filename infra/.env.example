# infra/compose.yaml 환경변수. 이 파일을 infra/.env로 복사해서 값을 채우세요 (.env는 커밋하지 않음)

# DB
POSTGRES_DB=paircar
POSTGRES_USER=paircar
POSTGRES_PASSWORD=change-me

# 외부에 여는 nginx 포트 (호스트 쪽)
HTTP_PORT=80
HTTPS_PORT=443

# 서버(HTTPS)에서만: 인증서를 받을 도메인과 Let's Encrypt 알림 메일
DOMAIN=
CERTBOT_EMAIL=

# 동승자 웹 주소 (서버와 따로 배포). 이 출처만 브라우저에서 API를 부를 수 있음. 쉼표로 여러 개, 끝에 / 없이
PAIRCAR_CORS_ALLOWED_ORIGINS=http://localhost:3000

# 동승자 웹의 초대 참여 경로. 초대 링크 = 이 값 + "/" + code
PAIRCAR_INVITE_BASE_URL=http://localhost:3000/join

# Web Push VAPID 키 (npx web-push generate-vapid-keys). 비우면 Push만 꺼짐
PAIRCAR_VAPID_PUBLIC_KEY=
PAIRCAR_VAPID_PRIVATE_KEY=
PAIRCAR_VAPID_SUBJECT=mailto:admin@paircar.app
